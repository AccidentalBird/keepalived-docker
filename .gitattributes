# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Shell scripts — force LF, diff as bash
*.sh text eol=lf diff=bash

# YAML/config — force LF
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.conf text eol=lf

# Env templates — force LF
*.env.template text eol=lf

# Binary files — don't diff or merge
*.png binary
*.jpg binary
*.p12 binary
*.pfx binary
